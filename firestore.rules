// ════════════════════════════════════════════════════════════════
// CANONICAL FIRESTORE RULES NOW LIVE IN nexus-portal/firestore.rules
// ════════════════════════════════════════════════════════════════
// Do NOT edit this file. Do NOT deploy rules from this repo.
// PR CI deploys hosting + functions only (NOT firestore:rules).
// The canonical rules file is maintained and deployed from:
//   https://github.com/onepowerLS/nexus-portal/blob/main/firestore.rules
// See: nexus-portal/docs/PR_NEXUS_COEXISTENCE_PLAN.md
// ════════════════════════════════════════════════════════════════
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This file is intentionally empty. Rules are deployed from nexus-portal.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
